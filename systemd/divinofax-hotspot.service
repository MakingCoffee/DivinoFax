[Unit]
Description=DivinoFax Hotspot Auto-Connect
After=network-online.target NetworkManager.service
Before=divinofax.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/oracle/divinofax/scripts/hotspot_autoconnect.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=divinofax-hotspot
EnvironmentFile=/home/oracle/divinofax/config/hotspot.env

[Install]
WantedBy=multi-user.target
